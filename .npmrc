############################
# Artifactory .npmrc       #
############################

registry = https://artifacts.sei.cmu.edu/artifactory/api/npm/npm-remote/
@sds:registry = https://artifacts.sei.cmu.edu/artifactory/api/npm/sei-design-system/

# When installing via npm, some dependencies have postinstall requirements that
# pull resources from other sources online.

# In order to properly access some of those resources within the SEI network,
# use the following settings to point the libraries at our internal
# Artifactory mirror.

## node-sass
sass_binary_site = https://artifacts.sei.cmu.edu/artifactory/npm-taobao-remote/node-sass
## chromedriver
chromedriver_cdnurl = https://artifacts.sei.cmu.edu/artifactory/npm-taobao-remote/chromedriver
## Font Awesome Pro
@fortawesome:registry=https://artifacts.sei.cmu.edu/artifactory/api/npm/fontawesome-pro-npm-remote/
